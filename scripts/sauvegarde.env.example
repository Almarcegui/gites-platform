# Identifiants de la sauvegarde de nuit (scripts/sauvegarde_nuit.py --cible infomaniak).
#
# À copier en ~/.config/gites/sauvegarde.env sur le Mac, puis : chmod 600 ~/.config/gites/sauvegarde.env
# Jamais dans le dépôt (le script refuse un fichier lisible par d'autres comptes).
#
# Le compte « sauvegarde » se crée dans le back-office, page Utilisateurs
# (identifiant exactement « sauvegarde ») : le mot de passe affiché une seule
# fois va ci-dessous. Ce compte n'ouvre QUE l'export de la base
# (/api/admin/export.sqlite) — aucune autre page, aucune écriture.

GITES_URL=https://dev1.mdcdy.be
GITES_USER=sauvegarde
GITES_PASSWORD=
