# Accès de service de Claude et des scripts du Mac (scripts/gites_admin.py, connecteur mcp/).
#
# À copier en ~/.config/gites/service.env, puis : chmod 600 ~/.config/gites/service.env
# Jamais dans le dépôt.
#
# La clé se crée dans le back-office, page Utilisateurs › Accès de service
# (« Créer une clé »), depuis une session humaine. Elle n'est affichée qu'une
# fois ; perdue ou fuitée : la révoquer au même endroit et en créer une autre.

GITES_URL=https://dev1.mdcdy.be
GITES_SERVICE_KEY=
